# MongoDB configuration
MONGO_ROOT_USERNAME=your_mongodb_username
MONGO_ROOT_PASSWORD=your_mongodb_password

# Mongo Express authentication
MONGO_EXPRESS_USERNAME=your_viewer_username
MONGO_EXPRESS_PASSWORD=your_viewer_password

# Airflow MongoDB connection
CURRENCY_MONGO_URI=mongodb://your_mongodb_username:your_mongodb_password@mongodb:27017/?authSource=admin